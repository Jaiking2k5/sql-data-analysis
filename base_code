# ============================================================
# CUSTOMER ANALYSIS
# ============================================================

def customer_analysis(
    connection
):

    query = """

        WITH customer_totals AS (

            SELECT

                c.customer_id,

                c.customer_name,

                c.region,

                COUNT(
                    o.order_id
                ) AS order_count,

                SUM(
                    o.amount
                ) AS total_spend,

                AVG(
                    o.amount
                ) AS average_order_value

            FROM customers AS c

            INNER JOIN orders AS o

                ON c.customer_id =
                   o.customer_id

            GROUP BY

                c.customer_id,

                c.customer_name,

                c.region
        ),


        ranked_customers AS (

            SELECT

                *,

                RANK() OVER (

                    PARTITION BY region

                    ORDER BY
                        total_spend DESC

                ) AS regional_rank,


                RANK() OVER (

                    ORDER BY
                        total_spend DESC

                ) AS overall_rank

            FROM customer_totals
        )


        SELECT

            customer_id,

            customer_name,

            region,

            order_count,

            ROUND(
                total_spend,
                2
            ) AS total_spend,

            ROUND(
                average_order_value,
                2
            ) AS average_order_value,

            regional_rank,

            overall_rank

        FROM ranked_customers

        ORDER BY overall_rank;

    """

    return pd.read_sql_query(
        query,
        connection
    )


# ============================================================
# REGION ANALYSIS
# ============================================================

def region_analysis(
    connection
):

    query = """

        SELECT

            c.region,

            COUNT(
                o.order_id
            ) AS total_orders,

            ROUND(
                SUM(o.amount),
                2
            ) AS total_revenue,

            ROUND(
                AVG(o.amount),
                2
            ) AS average_order_value

        FROM customers AS c

        INNER JOIN orders AS o

            ON c.customer_id =
               o.customer_id

        GROUP BY c.region

        ORDER BY
            total_revenue DESC;

    """

    return pd.read_sql_query(
        query,
        connection
    )


# ============================================================
# MONTHLY ANALYSIS
# ============================================================

def monthly_analysis(
    connection
):

    query = """

        SELECT

            substr(
                order_date,
                1,
                7
            ) AS month,

            COUNT(*) AS orders,

            ROUND(
                SUM(amount),
                2
            ) AS revenue

        FROM orders

        GROUP BY month

        ORDER BY month;

    """

    return pd.read_sql_query(
        query,
        connection
    )


# ============================================================
# PANDAS ANALYSIS
# ============================================================

def pandas_analysis(
    customer_df
):

    print(
        "\nPandas summary:"
    )

    print(
        customer_df[
            [
                "region",
                "total_spend"
            ]
        ]
        .groupby("region")
        .sum()
        .sort_values(
            "total_spend",
            ascending=False
        )
    )


# ============================================================
# MAIN
# ============================================================

def main():

    connection = create_connection()

    try:

        create_tables(
            connection
        )

        insert_sample_data(
            connection
        )


        # ----------------------------------------------------
        # CUSTOMER ANALYSIS
        # ----------------------------------------------------

        customers = customer_analysis(
            connection
        )

        print(
            "\n"
            + "=" * 70
        )

        print(
