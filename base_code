            monthly.to_string(
                index=False
            )
        )


        # ----------------------------------------------------
        # PANDAS
        # ----------------------------------------------------

        pandas_analysis(
            customers
        )


        # ----------------------------------------------------
        # EXPORT
        # ----------------------------------------------------

        customers.to_csv(
            OUTPUT_FILE,
            index=False
        )

        print(
            f"\nCustomer results saved to:"
            f" {Path(OUTPUT_FILE).resolve()}"
        )

        print(
            f"SQLite database:"
            f" {Path(DATABASE_FILE).resolve()}"
        )


    finally:

        connection.close()


if __name__ == "__main__":

    main()
