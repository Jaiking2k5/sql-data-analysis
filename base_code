"""

from __future__ import annotations

import sqlite3
from pathlib import Path

import pandas as pd


DATABASE_FILE = "analysis.db"
OUTPUT_FILE = "customer_analysis.csv"


# ============================================================
# DATABASE CONNECTION
# ============================================================

def create_connection():

    connection = sqlite3.connect(
        DATABASE_FILE
    )

    connection.execute(
        "PRAGMA foreign_keys = ON;"
    )

    return connection


# ============================================================
# DATABASE SCHEMA
# ============================================================

def create_tables(
    connection
):

    connection.executescript("""

        DROP TABLE IF EXISTS orders;

        DROP TABLE IF EXISTS customers;


        CREATE TABLE customers (

            customer_id INTEGER
                PRIMARY KEY,

            customer_name TEXT
                NOT NULL,

            region TEXT
                NOT NULL
        );


        CREATE TABLE orders (

            order_id INTEGER
                PRIMARY KEY,

            customer_id INTEGER
                NOT NULL,

            order_date TEXT
                NOT NULL,

            amount REAL
                NOT NULL,

            FOREIGN KEY (
                customer_id
            )
            REFERENCES customers(
                customer_id
            )
        );

    """)

    connection.commit()


