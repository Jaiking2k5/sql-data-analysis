        )

        print(
            "=" * 70
        )

        print(
            customers.to_string(
                index=False
            )
        )


        # ----------------------------------------------------
        # REGION ANALYSIS
        # ----------------------------------------------------

        regions = region_analysis(
            connection
        )

        print(
            "\n"
            + "=" * 70
        )

        print(
            "REGION ANALYSIS"
        )

        print(
            "=" * 70
        )

        print(
            regions.to_string(
